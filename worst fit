# Worst Fit Memory Allocation in Python
def worstFit(process_size, block_size):
    allocation = [-1] * len(process_size)  # initially no process is allocated

    # pick each process and find the worst fit block
    for i in range(len(process_size)):
        worst_index = -1
        for j in range(len(block_size)):
            if block_size[j] >= process_size[i]:
                if worst_index == -1 or block_size[j] > block_size[worst_index]:
                    worst_index = j

        # if a block is found for the process
        if worst_index != -1:
            allocation[i] = worst_index
            block_size[worst_index] -= process_size[i]

    # print allocation result
    print("\nProcess No.\tProcess Size\tBlock No.")
    for i in range(len(process_size)):
        print(f"{i + 1}\t\t{process_size[i]}\t\t", end="")
        if allocation[i] != -1:
            print(allocation[i] + 1)
        else:
            print("Not Allocated")


